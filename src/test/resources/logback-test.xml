<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- One file per run's worth of history, rotated by day and capped in
         total size - CI uploads this whole directory as a build artifact
         (see .github/workflows/tests.yml), which is what you want to attach
         when a run fails and the console scrollback is gone. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/bulksms-api-tests.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>target/logs/bulksms-api-tests.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Every request/response bulksms-api-tests makes (to bulksms-api AND to
         TestRail) goes through ApiLoggingFilter into this logger. INFO gives
         one line per call (method, URI, status, duration); DEBUG adds request/
         response bodies. Override without editing this file:
           mvn test -Dbulksmsapi.log.level=DEBUG -Dbulksmsapi.http.log.level=DEBUG -->
    <logger name="bulksmsapi" level="${bulksmsapi.log.level:-INFO}" />
    <logger name="bulksmsapi.http" level="${bulksmsapi.http.log.level:-INFO}" />

    <!-- REST Assured's own internal logging is separate from bulksmsapi.http -
         left at WARN so it doesn't duplicate what the filter already logs. -->
    <logger name="io.restassured" level="WARN" />
    <logger name="org.apache.http" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
